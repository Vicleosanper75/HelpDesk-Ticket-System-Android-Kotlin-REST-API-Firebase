# Server Configuration
PORT=3001

# JWT Authentication Secrets
# Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your_very_long_random_secret_here_min_32_characters
REFRESH_TOKEN_SECRET=your_very_long_random_secret_here_min_32_characters

# Firebase Configuration
# Download serviceAccountKey.json from Firebase Console and add it to project root
# See DOCUMENTATION.md for setup instructions
FIREBASE_PROJECT_ID=your_firebase_project_id